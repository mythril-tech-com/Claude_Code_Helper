{
  "name": "claude-add-to-chat",
  "displayName": "Claude Add to Chat",
  "description": "Add file, folder and line references to Claude Code's chat, like Cursor's \"Add to chat\".",
  "version": "0.0.8",
  "publisher": "mythriltech",
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "claudeAddToChat.add",
        "title": "Add to Claude"
      },
      {
        "command": "claudeAddToChat.addToNewChat",
        "title": "Add to New Claude Chat"
      },
      {
        "command": "claudeAddToChat.addSelection",
        "title": "Add Selection to Claude"
      },
      {
        "command": "claudeAddToChat.addSelectionToNewChat",
        "title": "Add Selection to New Claude Chat"
      },
      {
        "command": "claudeAddToChat.addToSidebar",
        "title": "Add to Claude"
      },
      {
        "command": "claudeAddToChat.addToNewSidebarChat",
        "title": "Add to New Claude Chat"
      },
      {
        "command": "claudeAddToChat.addSelectionToSidebar",
        "title": "Add Selection to Claude"
      },
      {
        "command": "claudeAddToChat.addSelectionToNewSidebarChat",
        "title": "Add Selection to New Claude Chat"
      },
      {
        "command": "claudeAddToChat.addToTab",
        "title": "Add to Claude (Tab)"
      },
      {
        "command": "claudeAddToChat.addToNewTabChat",
        "title": "Add to New Claude Chat (Tab)"
      },
      {
        "command": "claudeAddToChat.addSelectionToTab",
        "title": "Add Selection to Claude (Tab)"
      },
      {
        "command": "claudeAddToChat.addSelectionToNewTabChat",
        "title": "Add Selection to New Claude Chat (Tab)"
      },
      {
        "command": "claudeAddToChat.clear",
        "title": "Clear Claude References"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "claudeAddToChat.add",
          "when": "!claudeAddToChat.sidebar",
          "group": "1_claude@1"
        },
        {
          "command": "claudeAddToChat.addToNewChat",
          "when": "!claudeAddToChat.sidebar",
          "group": "1_claude@2"
        },
        {
          "command": "claudeAddToChat.addToSidebar",
          "when": "claudeAddToChat.sidebar",
          "group": "1_claude@1"
        },
        {
          "command": "claudeAddToChat.addToNewSidebarChat",
          "when": "claudeAddToChat.sidebar",
          "group": "1_claude@2"
        },
        {
          "command": "claudeAddToChat.addToTab",
          "when": "claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions",
          "group": "1_claude@3"
        },
        {
          "command": "claudeAddToChat.addToNewTabChat",
          "when": "claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions",
          "group": "1_claude@4"
        }
      ],
      "editor/title/context": [
        {
          "command": "claudeAddToChat.add",
          "when": "!claudeAddToChat.sidebar",
          "group": "1_claude@1"
        },
        {
          "command": "claudeAddToChat.addToNewChat",
          "when": "!claudeAddToChat.sidebar",
          "group": "1_claude@2"
        },
        {
          "command": "claudeAddToChat.addToSidebar",
          "when": "claudeAddToChat.sidebar",
          "group": "1_claude@1"
        },
        {
          "command": "claudeAddToChat.addToNewSidebarChat",
          "when": "claudeAddToChat.sidebar",
          "group": "1_claude@2"
        },
        {
          "command": "claudeAddToChat.addToTab",
          "when": "claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions",
          "group": "1_claude@3"
        },
        {
          "command": "claudeAddToChat.addToNewTabChat",
          "when": "claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions",
          "group": "1_claude@4"
        }
      ],
      "editor/context": [
        {
          "command": "claudeAddToChat.addSelection",
          "when": "editorHasSelection && !claudeAddToChat.sidebar",
          "group": "1_claude@1"
        },
        {
          "command": "claudeAddToChat.addSelectionToNewChat",
          "when": "editorHasSelection && !claudeAddToChat.sidebar",
          "group": "1_claude@2"
        },
        {
          "command": "claudeAddToChat.addSelectionToSidebar",
          "when": "editorHasSelection && claudeAddToChat.sidebar",
          "group": "1_claude@1"
        },
        {
          "command": "claudeAddToChat.addSelectionToNewSidebarChat",
          "when": "editorHasSelection && claudeAddToChat.sidebar",
          "group": "1_claude@2"
        },
        {
          "command": "claudeAddToChat.addSelectionToTab",
          "when": "editorHasSelection && claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions",
          "group": "1_claude@3"
        },
        {
          "command": "claudeAddToChat.addSelectionToNewTabChat",
          "when": "editorHasSelection && claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions",
          "group": "1_claude@4"
        }
      ],
      "commandPalette": [
        {
          "command": "claudeAddToChat.add",
          "when": "!claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addToNewChat",
          "when": "!claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addSelection",
          "when": "editorHasSelection && !claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addSelectionToNewChat",
          "when": "editorHasSelection && !claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addToSidebar",
          "when": "claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addToNewSidebarChat",
          "when": "claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addSelectionToSidebar",
          "when": "editorHasSelection && claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addSelectionToNewSidebarChat",
          "when": "editorHasSelection && claudeAddToChat.sidebar"
        },
        {
          "command": "claudeAddToChat.addToTab",
          "when": "claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions"
        },
        {
          "command": "claudeAddToChat.addToNewTabChat",
          "when": "claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions"
        },
        {
          "command": "claudeAddToChat.addSelectionToTab",
          "when": "editorHasSelection && claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions"
        },
        {
          "command": "claudeAddToChat.addSelectionToNewTabChat",
          "when": "editorHasSelection && claudeAddToChat.sidebar && config.claudeAddToChat.showTabOptions"
        }
      ]
    },
    "views": {
      "claude-sidebar-secondary": [
        {
          "id": "claudeAddToChat.dropSecondary",
          "name": "Drop Files for Claude",
          "when": "claudeAddToChat.sidebar && !claude-code:doesNotSupportSecondarySidebar"
        }
      ],
      "claude-sidebar": [
        {
          "id": "claudeAddToChat.drop",
          "name": "Drop Files for Claude",
          "when": "claudeAddToChat.sidebar && claude-code:doesNotSupportSecondarySidebar"
        }
      ]
    },
    "keybindings": [
      {
        "command": "claudeAddToChat.addSelection",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection && !claudeAddToChat.sidebar"
      },
      {
        "command": "claudeAddToChat.addSelectionToSidebar",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && editorHasSelection && claudeAddToChat.sidebar"
      }
    ],
    "configuration": {
      "title": "Claude Add to Chat",
      "properties": {
        "claudeAddToChat.autoClearSeconds": {
          "type": "number",
          "default": 120,
          "minimum": 0,
          "maximum": 86400,
          "markdownDescription": "Clear the reference basket after this many seconds without a new add. `0` means never."
        },
        "claudeAddToChat.autoPaste": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "**Add to Claude** puts the references straight into the open Claude Code chat. Turn this off to paste them yourself with `Ctrl+V`. **Add to New Claude Chat** always fills in the new chat."
        },
        "claudeAddToChat.showTabOptions": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Also show the **(Tab)** options, which add to Claude Code's chat in an editor tab instead of its Side Bar chat."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx @vscode/vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "1.98.0",
    "typescript": "^5.8.0"
  }
}
